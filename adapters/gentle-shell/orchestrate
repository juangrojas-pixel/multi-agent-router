#!/usr/bin/env bash
# Starts gentle-shell as the orchestrator with the router's generated guidance as extra system
# prompt. It holds no rule, role or agent name of its own: the text comes from the router,
# called by path, and falls back to routing.general when that call fails or prints nothing.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
CONFIG="${ASK_AGENT_CONFIG:-$ROOT/agents.json}"

guidance="$(ASK_AGENT_CONFIG="$CONFIG" "$ROOT/bin/ask-agent-ts" guidance 2>/dev/null)" || guidance=""
[[ -n "${guidance//[[:space:]]/}" ]] || guidance="$(jq -r '.routing.general // empty' "$CONFIG")"

exec gentle-shell -- --append-system-prompt "$guidance" "$@"
