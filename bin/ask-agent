#!/usr/bin/env bash
# ask-agent: route a prompt to external agent CLIs (codex/pi, agy, opencode,
# gentle-shell) by tier, with proactive quota checks and reactive fallback.
#
# Usage:
#   ask-agent [-t TIER | -a AGENT] [-m MODEL] [-C DIR] [PROMPT]   first ready agent answers
#   ask-agent parallel [-t TIER | -a A,B] [-C DIR] [PROMPT]       every ready agent answers
#   ask-agent status                                              readiness, tiers, agy quota
#   ask-agent reset [AGENT]                                       clear cooldowns
# Tiers: think | execute | draft (see agents.json). Prompt is read from stdin if omitted.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG="${ASK_AGENT_CONFIG:-$ROOT/agents.json}"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/multi-agent-router"
COOLDOWN_FILE="$STATE_DIR/cooldown.json"
QUOTA_ERROR_RE='rate.?limit|quota|429|resource.?exhausted|usage limit|too many requests|limit reached'

log() { printf '[ask-agent] %s\n' "$*" >&2; }
die() { log "error: $*"; exit 2; }

command -v jq >/dev/null || die "jq is required"
[[ -f "$CONFIG" ]] || die "config not found: $CONFIG"
mkdir -p "$STATE_DIR"
[[ -f "$COOLDOWN_FILE" ]] || echo '{}' >"$COOLDOWN_FILE"

cfg() { jq -r "$1" "$CONFIG"; }
agent_cfg() { jq -r --arg a "$1" ".agents[\$a]$2" "$CONFIG"; }
now() { date +%s; }

# --- cooldowns --------------------------------------------------------------

cooldown_until() { jq -r --arg a "$1" '.[$a] // 0' "$COOLDOWN_FILE"; }

set_cooldown() {
  local agent="$1" until="$2" tmp
  tmp="$(mktemp)"
  jq --arg a "$agent" --argjson u "$until" '.[$a] = $u' "$COOLDOWN_FILE" >"$tmp" && mv "$tmp" "$COOLDOWN_FILE"
  log "$agent cooled down until $(date -r "$until" '+%Y-%m-%d %H:%M')"
}

clear_cooldown() {
  local tmp
  tmp="$(mktemp)"
  if [[ -n "${1:-}" ]]; then
    jq --arg a "$1" 'del(.[$a])' "$COOLDOWN_FILE" >"$tmp"
  else
    echo '{}' >"$tmp"
  fi
  mv "$tmp" "$COOLDOWN_FILE"
}

# --- process control --------------------------------------------------------

# Runs a command with a hard time limit (macOS has no coreutils `timeout`).
# The command gets its own process group and no stdin, so wrapper CLIs
# (node -> pi) are killed together with their children; exits 142 on expiry.
with_timeout() {
  local secs="$1"; shift
  perl -e '
    my $secs = shift;
    my $pid = fork() // die "fork failed: $!";
    if ($pid == 0) { setpgrp(0, 0); open(STDIN, "<", "/dev/null"); exec @ARGV or die "exec failed: $!"; }
    local $SIG{ALRM} = sub {
      kill "TERM", -$pid; sleep 2; kill "KILL", -$pid;
      waitpid($pid, 0); exit 142;
    };
    alarm $secs;
    waitpid($pid, 0);
    exit($? & 127 ? 128 + ($? & 127) : $? >> 8);
  ' "$secs" "$@"
}

# --- agy quota ----------------------------------------------------------------

agy_usage_json() {
  with_timeout 45 "$(agent_cfg agy .command)" -p "/usage" --output-format json --print-timeout 30s 2>/dev/null
}

# Prints "<min remaining fraction> <reset epoch of that bucket>" for the configured group.
agy_quota() {
  local group usage
  group="$(agent_cfg agy .quota.group)"
  usage="$(agy_usage_json)" || return 1
  jq -r --arg g "$group" '
    [.command.data.groups[] | select(.name == $g) | .buckets[]] as $b
    | if ($b | length) == 0 then empty
      else ($b | min_by(.remaining_fraction)) as $m
        | "\($m.remaining_fraction) \($m.reset_time | fromdateiso8601)"
      end' <<<"$usage"
}

# --- availability -------------------------------------------------------------

# Returns 0 when the agent can be called now; prints the skip reason otherwise.
check_agent() {
  local agent="$1" cmd until quota remaining reset min
  [[ "$(agent_cfg "$agent" .enabled)" == "true" ]] || { echo "disabled"; return 1; }
  cmd="$(agent_cfg "$agent" .command)"
  command -v "$cmd" >/dev/null || { echo "command not found: $cmd"; return 1; }
  until="$(cooldown_until "$agent")"
  ((until > $(now))) && { echo "cooldown until $(date -r "$until" '+%H:%M')"; return 1; }

  if [[ "$agent" == "agy" && -n "$(agent_cfg agy '.quota // empty')" ]]; then
    quota="$(agy_quota)" || { echo "quota check failed"; return 1; }
    [[ -n "$quota" ]] || { echo "quota group not found"; return 1; }
    read -r remaining reset <<<"$quota"
    min="$(agent_cfg agy .quota.min_remaining)"
    if jq -en --argjson r "$remaining" --argjson m "$min" '$r < $m' >/dev/null; then
      set_cooldown agy "$reset" >/dev/null 2>&1
      echo "quota low ($(jq -n "$remaining * 100 | floor")% < $(jq -n "$min * 100 | floor")%)"
      return 1
    fi
  fi
  return 0
}

# --- invocation -----------------------------------------------------------------

# Runs the agent; answer on stdout. Exit 0 ok, 3 quota error, 1 other failure.
run_agent() {
  local agent="$1" prompt="$2" model="$3" cmd out err rc arg secs answer
  cmd="$(agent_cfg "$agent" .command)"
  [[ -n "$model" ]] || model="$(agent_cfg "$agent" '.model // empty')"
  secs="$(agent_cfg "$agent" '.timeout_seconds // 600')"
  local -a args=()
  while IFS= read -r arg; do [[ -n "$arg" ]] && args+=("$arg"); done < <(agent_cfg "$agent" '.extra_args[]?')

  err="$(mktemp)"
  case "$agent" in
    codex)
      out="$(with_timeout "$secs" "$cmd" -p --no-session --no-extensions --no-skills --no-context-files \
        ${model:+--model "$model"} ${args[@]+"${args[@]}"} "$prompt" 2>"$err")"
      rc=$?
      answer="$out"
      ;;
    agy)
      out="$(with_timeout "$((secs + 30))" "$cmd" -p "$prompt" --output-format json --print-timeout "${secs}s" \
        ${model:+--model "$model"} ${args[@]+"${args[@]}"} 2>"$err")"
      rc=$?
      answer=""
      [[ "$(jq -r '.status // empty' <<<"$out" 2>/dev/null)" == "SUCCESS" ]] && answer="$(jq -r '.response' <<<"$out")"
      ;;
    opencode)
      out="$(with_timeout "$secs" "$cmd" run --format json ${model:+-m "$model"} ${args[@]+"${args[@]}"} \
        "$prompt" 2>"$err")"
      rc=$?
      answer="$(jq -rj 'select(.type == "text") | .part.text // empty' <<<"$out" 2>/dev/null)"
      ;;
    gentle-shell)
      out="$(with_timeout "$secs" "$cmd" -- -p --no-session ${model:+--model "$model"} ${args[@]+"${args[@]}"} \
        "$prompt" 2>"$err")"
      rc=$?
      answer="$out"
      ;;
    *) rm -f "$err"; die "unknown agent: $agent" ;;
  esac
  out="$out"$'\n'"$(<"$err")"
  rm -f "$err"

  if ((rc == 0)) && [[ -n "${answer//[[:space:]]/}" ]]; then
    printf '%s\n' "$answer"
    return 0
  fi
  if ((rc == 142)); then
    log "$agent timed out after ${secs}s"
    return 1
  fi
  if grep -Eqi "$QUOTA_ERROR_RE" <<<"$out"; then
    log "$agent hit a quota/rate limit: $(tail -n 3 <<<"$out" | tr '\n' ' ')"
    return 3
  fi
  log "$agent failed (exit $rc): $(tail -n 5 <<<"$out" | tr '\n' ' ')"
  return 1
}

# Runs one agent and applies the cooldown on quota errors.
attempt() {
  local agent="$1" prompt="$2" model="$3" rc
  log "using $agent"
  run_agent "$agent" "$prompt" "$model"
  rc=$?
  ((rc == 3)) && set_cooldown "$agent" $(($(now) + $(cfg '.cooldown_seconds // 3600')))
  return $rc
}

# --- argument parsing -----------------------------------------------------------

# Sets globals: TIER AGENTS MODEL PROMPT (and cds into -C DIR).
parse_args() {
  TIER="" AGENTS="" MODEL="" PROMPT=""
  local dir=""
  while (($#)); do
    case "$1" in
      -t|--tier) TIER="$2"; shift 2 ;;
      -a|--agent) AGENTS="$2"; shift 2 ;;
      -m|--model) MODEL="$2"; shift 2 ;;
      -C|--cwd) dir="$2"; shift 2 ;;
      -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
      --) shift; PROMPT="$*"; break ;;
      -*) die "unknown option: $1" ;;
      *) PROMPT="$*"; break ;;
    esac
  done
  [[ -z "$TIER" || -z "$AGENTS" ]] || die "use either -t or -a, not both"
  [[ -n "$PROMPT" ]] || { [[ -t 0 ]] && die "no prompt given"; PROMPT="$(cat)"; }
  [[ -n "${PROMPT//[[:space:]]/}" ]] || die "empty prompt"
  [[ -z "$dir" ]] || cd "$dir" || die "cannot cd to $dir"
}

# Prints the candidate agents, one per line, from -a or the tier list.
candidates() {
  local a
  if [[ -n "$AGENTS" ]]; then
    tr ',' '\n' <<<"$AGENTS" | while IFS= read -r a; do
      [[ -n "$a" ]] || continue
      jq -e --arg a "$a" '.agents[$a]' "$CONFIG" >/dev/null || die "unknown agent: $a"
      echo "$a"
    done
  else
    local tier="${TIER:-$(cfg '.default_tier // "execute"')}"
    jq -e --arg t "$tier" '.tiers[$t]' "$CONFIG" >/dev/null || die "unknown tier: $tier"
    jq -r --arg t "$tier" '.tiers[$t][]' "$CONFIG"
  fi
}

# --- commands ---------------------------------------------------------------------

cmd_ask() {
  parse_args "$@"
  local -a list=()
  local a reason
  while IFS= read -r a; do list+=("$a"); done < <(candidates)
  ((${#list[@]})) || exit 2

  for a in "${list[@]}"; do
    if ! reason="$(check_agent "$a")"; then
      log "skip $a: $reason"
      continue
    fi
    attempt "$a" "$PROMPT" "$MODEL" && return 0
  done
  die "no agent could answer (tried: ${list[*]})"
}

cmd_parallel() {
  parse_args "$@"
  local -a list=() ready=() pids=()
  local a reason i tmpdir ok=0
  while IFS= read -r a; do list+=("$a"); done < <(candidates)
  ((${#list[@]})) || exit 2

  for a in "${list[@]}"; do
    if reason="$(check_agent "$a")"; then ready+=("$a"); else log "skip $a: $reason"; fi
  done
  ((${#ready[@]})) || die "no agent ready (checked: ${list[*]})"

  tmpdir="$(mktemp -d)"
  for i in "${!ready[@]}"; do
    attempt "${ready[$i]}" "$PROMPT" "$MODEL" >"$tmpdir/$i.out" 2>"$tmpdir/$i.err" &
    pids+=($!)
  done
  for i in "${!ready[@]}"; do
    if wait "${pids[$i]}"; then
      ok=1
      printf '### %s\n\n' "${ready[$i]}"
      cat "$tmpdir/$i.out"
      echo
    else
      printf '### %s\n\n_(no answer: %s)_\n\n' "${ready[$i]}" "$(tail -n 1 "$tmpdir/$i.err" | sed 's/^\[ask-agent\] //')"
    fi
    cat "$tmpdir/$i.err" >&2
  done
  rm -rf "$tmpdir"
  ((ok)) || die "no agent could answer"
}

cmd_status() {
  local agent reason tiers
  while IFS= read -r agent; do
    tiers="$(jq -r --arg a "$agent" '[.tiers | to_entries[] | select(.value | index($a)) | .key] | if length == 0 then "explicit only" else join(",") end' "$CONFIG")"
    if reason="$(check_agent "$agent")"; then
      printf '%-13s %-24s ready\n' "$agent" "[$tiers]"
    else
      printf '%-13s %-24s skip: %s\n' "$agent" "[$tiers]" "$reason"
    fi
  done < <(cfg '.agents | keys_unsorted[]')

  if [[ "$(agent_cfg agy .enabled)" == "true" ]] && command -v "$(agent_cfg agy .command)" >/dev/null; then
    echo
    echo "agy quota:"
    agy_usage_json | jq -r '.command.data.groups[] | .name as $g | .buckets[]
      | "  \($g) / \(.window): \(.remaining_fraction * 100 | floor)% (reset \(.reset_time))"'
  fi
}

case "${1:-}" in
  status) cmd_status ;;
  reset) clear_cooldown "${2:-}"; log "cooldown cleared ${2:-for all agents}" ;;
  parallel) shift; cmd_parallel "$@" ;;
  *) cmd_ask "$@" ;;
esac
