#!/usr/bin/env bash
# route-hint: UserPromptSubmit hook that turns the routing policy into a per-prompt directive,
# and logs each decision (never the prompt text). The policy is the merged config printed by
# `ask-agent-ts config` (agents.json with the private policy file over it); when that call fails
# or prints nothing, agents.json itself is read.
#
# Usage:
#   route-hint            read the hook JSON on stdin, print hook JSON on stdout
#   route-hint --stats    count logged decisions per rule
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONFIG="${ASK_AGENT_CONFIG:-$ROOT/agents.json}"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/multi-agent-router"
LOG="$STATE_DIR/route.jsonl"

if [[ "${1:-}" == "--stats" ]]; then
  [[ -s "$LOG" ]] || { echo "no decisions logged yet ($LOG)"; exit 0; }
  jq -rs 'group_by(.rule) | map("\(length)\t\(.[0].rule)\t\(.[0].agent // (.[0].role | if . then "role:\(.)" else null end) // "inline")")
    | sort_by(-(split("\t")[0] | tonumber)) | .[]' "$LOG"
  exit 0
fi

prompt="$(jq -r '.prompt // ""')"
# Slash commands carry their own instructions; leave them alone.
[[ "$prompt" == /* ]] && exit 0
# Background-task events arrive as prompts too; they are not user requests.
[[ "$prompt" == *"<task-notification>"* || "$prompt" == *"[SYSTEM NOTIFICATION"* ]] && exit 0

# The merged config, read once per prompt; called by path next to this script.
cfg="$(ASK_AGENT_CONFIG="$CONFIG" "$ROOT/bin/ask-agent-ts" config 2>/dev/null)" || cfg=""
# A regex test, not ${cfg//[[:space:]]/}: that substitution takes about 300 ms on the config.
[[ "$cfg" =~ [^[:space:]] ]] || cfg="$(<"$CONFIG")"

# First matching rule wins; inline rules come first. A rule names an agent (`ask-agent -a`)
# or a role (`ask-agent -r`).
decision="$(jq -c --arg p "$prompt" '
  .routing as $r
  | ([$r.rules[] | select(.match as $m | $p | test($m; "i"))] | first) as $hit
  | if $hit == null then {rule: "none", agent: null, text: null}
    elif $hit.agent == null and $hit.role == null then {rule: $hit.id, agent: null, text: null}
    else ($hit.agent // $hit.role) as $who
      | (if $hit.role then "ask-agent -r \($hit.role)" else "ask-agent -a \($hit.agent)" end) as $call
      | {rule: $hit.id, agent: $hit.agent, role: $hit.role,
         text: ($r.directive | gsub("\\{rule\\}"; $hit.id) | gsub("\\{call\\}"; $call) | gsub("\\{agent\\}"; $who)
                | gsub("\\{verify\\}"; $hit.verify // ""))}
    end' <<<"$cfg")"

# Unmatched prompts get the router's guidance (generated from the roles), called by path next
# to this script; when it fails or prints nothing, the general policy is the fall back.
if [[ "$(jq -r '.rule' <<<"$decision")" == none ]]; then
  guidance="$(ASK_AGENT_CONFIG="$CONFIG" "$ROOT/bin/ask-agent-ts" guidance 2>/dev/null)" || guidance=""
  [[ -n "${guidance//[[:space:]]/}" ]] || guidance="$(jq -r '.routing.general // empty' <<<"$cfg")"
  decision="$(jq -c --arg t "$guidance" '.text = $t' <<<"$decision")"
fi

# ask-agent writes cooldown.json when an agent runs out of quota (until its reset, or
# cooldown_seconds after a quota error); skip routing to it until that passes.
now="$(date +%s)"
agent="$(jq -r '.agent // empty' <<<"$decision")"
role="$(jq -r '.role // empty' <<<"$decision")"
until=0
if [[ -n "$agent" && -s "$STATE_DIR/cooldown.json" ]]; then
  until="$(jq -r --arg a "$agent" '.[$a] // 0' "$STATE_DIR/cooldown.json" 2>/dev/null || echo 0)"
elif [[ -n "$role" && -s "$STATE_DIR/cooldown.json" ]]; then
  # A role is skipped only when every one of its agents is cooling down; it frees up when the
  # first of them does, so the earliest end is the one reported.
  until="$(jq -r --arg r "$role" --slurpfile c "$STATE_DIR/cooldown.json" '
    [.roles[$r].agents[]? | if type == "string" then . else .agent end | ($c[0][.] // 0)]
    | if length == 0 then 0 else min end' <<<"$cfg" 2>/dev/null || echo 0)"
fi
if ((until > now)); then
  if [[ -n "$role" ]]; then
    decision="$(jq -c --arg at "$(date -d "@$until" '+%H:%M')" '.cooldown = true
      | .text = "SKIP DELEGATION (multi-agent-router): this prompt matches `\(.rule)`, but every agent of role \(.role) is in cooldown (out of quota) until \($at). Do it yourself and say so in one line."' <<<"$decision")"
  else
    decision="$(jq -c --arg at "$(date -d "@$until" '+%H:%M')" '.cooldown = true
      | .text = "SKIP DELEGATION (multi-agent-router): this prompt matches `\(.rule)`, but \(.agent) is in cooldown (out of quota) until \($at). Do it yourself and say so in one line."' <<<"$decision")"
  fi
fi

mkdir -p "$STATE_DIR" 2>/dev/null &&
  jq -c --argjson ts "$now" --argjson len "${#prompt}" \
    '{ts: $ts, rule, agent} + (if .role then {role} else {} end) + {cooldown: (.cooldown // false), prompt_chars: $len}' <<<"$decision" >>"$LOG" 2>/dev/null || true

text="$(jq -r '.text // empty' <<<"$decision")"
[[ -n "$text" ]] || exit 0
jq -n --arg ctx "$text" '{hookSpecificOutput: {hookEventName: "UserPromptSubmit", additionalContext: $ctx}}'
