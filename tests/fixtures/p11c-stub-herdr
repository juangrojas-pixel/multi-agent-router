#!/usr/bin/env bash
# Fake herdr for P11 tests: supports pane run failure and hanging control calls.
printf '%s\n' "$(IFS='|'; echo "$*")" >> "$HERDR_CALLS"
case "$1 $2" in
  "pane split")
    if [[ "${HERDR_HANG_SPLIT:-}" == 1 ]]; then sleep 30; exit 0; fi
    if [[ "${HERDR_FAIL_SPLIT:-}" == 1 ]]; then echo '{"error":{"code":"no_space"}}' >&2; exit 1; fi
    echo '{"result":{"pane":{"pane_id":"w1:p9"}}}' ;;
  "pane run")
    if [[ "${HERDR_FAIL_RUN:-}" == 1 ]]; then echo '{"error":{"code":"pane_gone"}}' >&2; exit 1; fi
    setsid bash -c "$4" </dev/null >/dev/null 2>&1 & echo '{"result":{}}' ;;
  *) echo '{"result":{}}' ;;
esac
